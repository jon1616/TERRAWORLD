static func info(id: String) -> Dictionary:
	return EFFECTS.get(id, {})


## «Tizzone: un colpo su tre incendia…» per le schede.
static func line(id: String) -> String:
	var e := info(id)
	return "%s: %s" % [e.get("name", id), e.get("desc", "")] if not e.is_empty() else id
